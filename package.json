{
  "name": "use-persistence",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo for @1apostoli/use-external-state packages and examples",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "clean": "pnpm -r --filter './packages/*' run clean",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "examples:dev": "pnpm --filter './examples/*' dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.7.0",
    "@types/node": "^20.16.10",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "eslint": "^9.7.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^14.0.0",
    "prettier": "^3.3.1",
    "rimraf": "^5.0.5",
    "tsup": "^8.2.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.2",
    "vitest": "^1.1.0"
  },
  "packageManager": "pnpm@10.15.1"
}
