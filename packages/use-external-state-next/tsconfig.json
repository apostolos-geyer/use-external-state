{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-ts",
    "rootDir": "../../",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "baseUrl": ".",
    "paths": {
      "next/navigation": ["./types/next-navigation.d.ts"],
      "@1apostoli/use-external-state": ["../use-external-state/src/"]

    },
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false
  },
  "include": ["src", "types", "tests", "*.config.*", "package.json"],
  "exclude": ["build", "dist-ts", "node_modules", "tsup.config.ts"]
}
